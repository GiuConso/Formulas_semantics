<?xml version='1.0' encoding='utf-8'?>
<rdf:RDF xmlns:dct="http://purl.org/dc/terms/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:skos="http://www.w3.org/2004/02/skos/core#">
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#scheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
    <dct:title xml:lang="en">BCSL clause repertoire for Formulas and Semantics in Digital Diplomatics</dct:title>
    <dct:description xml:lang="en">Fourteen operational clause categories used to annotate sixteen BCSL notarial charters (1393-1486), with documented mappings to the VID.</dct:description>
    <dct:creator>Giuseppe Consolo</dct:creator>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-03</dct:created>
    <owl:versionInfo>0.1.2</owl:versionInfo>
    <dct:source rdf:resource="https://raw.githubusercontent.com/GVogeler/VID/cb6ffbb9cfa4cd820a5b0d0fd001a6f49a9c0599/skos/VID.rdf.xml" />
    <dct:source rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/BCSL_Evora.jsonl" />
    <dct:source>Giuseppe Consolo, Tamás Kovács and Georg Vogeler, Formulas and Semantics in Digital Diplomatics, section 2.3.</dct:source>
    <dct:isPartOf rdf:resource="https://github.com/GiuConso/Formulas_semantics" />

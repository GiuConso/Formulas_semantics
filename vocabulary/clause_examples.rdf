  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_14-PRECARIUM-7318-7514">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#precarium" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_14-PRECARIUM-7318-7514" />
    <rdf:value xml:lang="la">interim tamen, quousque prefate priorissa et moniales et conventus dicte domus et iardinelli possessionem adepti fuerint corporalem, prefatus magister Ciccus confexus est illam precario possidere.</rdf:value>
    <dct:identifier>BCSL_14-PRECARIUM-7318-7514</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_14-PRECARIUM-7318-7514">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#SpecificResource" />
    <oa:hasSource rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#document-BCSL_14" />

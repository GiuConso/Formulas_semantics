  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_20-DEFENSIO-4661-4969">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#defensio" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_20-DEFENSIO-4661-4969" />
    <rdf:value xml:lang="la">quatenus ipsi ven­ditores et quilibet ipsorum in solidum dictum totum annuum censum, sic venditum et per eam emptum, libere et imperpetuum defendant et defendere teneantur dicte sorori Mitule ab omnibus hominibus, denunciandi necessitate evicionis tempore per ipsos venditores dicte emptrici ex pacto remissa</rdf:value>
    <dct:identifier>BCSL_20-DEFENSIO-4661-4969</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_20-DEFENSIO-4661-4969">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#SpecificResource" />

  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_25-CAPITULUM-1491-1678">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />

  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_33-IURAMENTUM-7502-7847">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#iuramentum" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_33-IURAMENTUM-7502-7847" />
    <rdf:value xml:lang="la">Maioris quoque securitatis causa voluntarie prefatus venditor eidem emptori presenti et stipulanti ut supra iuravit ad sancta Dei evangelia, posita manu super cruce cui habitus est religionis predicta omnia et singula adimplere attendere et observare contra non facere dicere opponere allegare vel venire de iure vel de facto seu modo quocumque.</rdf:value>
    <dct:identifier>BCSL_33-IURAMENTUM-7502-7847</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_33-IURAMENTUM-7502-7847">

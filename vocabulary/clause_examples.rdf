  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_35-RESTITUTIO_IN_INTEGRUM-3389-3725">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#restitutio-in-integrum" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_35-RESTITUTIO_IN_INTEGRUM-3389-3725" />
    <rdf:value xml:lang="la">et si cessaverint in solutione dicti census vel in cultura ipsius paludis statim cadat a concessione presenti et liceat in dicto casu dicta vinealia cum lacu capere ingredi et apprehendere propria auctoritate sine decreto et licencia curie solo presentis instrumenti et ad earum pristinum dominium reducere propria auctoritate ut supra.</rdf:value>
    <dct:identifier>BCSL_35-RESTITUTIO_IN_INTEGRUM-3389-3725</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_35-RESTITUTIO_IN_INTEGRUM-3389-3725">

    <rdf:value xml:lang="la">guadia et sollemni stipulacione inde adhibitis</rdf:value>
    <dct:identifier>BCSL_23-STIPULATIO-5079-5125</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_23-STIPULATIO-5079-5125">

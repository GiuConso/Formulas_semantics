  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_18-PRECARIUM-5300-5642">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#precarium" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_18-PRECARIUM-5300-5642" />
    <rdf:value xml:lang="la">et interim et donec ipsa emptrix vel sui successores domum ipsius adepti fuerint corporalem fatetur dicta venditrix domum ipsam precario nomine et pro parte ipsius sororis Petrelle et eius successorum tenere et eciam possidere, quod precarium prefata soror Petrella et sui successores possint cum voluerint auctoritate eorum propria revocare.</rdf:value>
    <dct:identifier>BCSL_18-PRECARIUM-5300-5642</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_18-PRECARIUM-5300-5642">

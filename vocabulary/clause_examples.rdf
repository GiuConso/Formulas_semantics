    <rdf:value xml:lang="la">per guadiam et stipulacionem legitimam et [laucna]</rdf:value>
    <dct:identifier>BCSL_33-STIPULATIO-3749-3799</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_33-STIPULATIO-3749-3799">

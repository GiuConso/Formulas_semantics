  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_35-PROROGATIO_IURISDICTIONIS-1636-1885">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#prorogatio-iurisdictionis" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_35-PROROGATIO_IURISDICTIONIS-1636-1885" />
    <rdf:value xml:lang="la">consentientes prius in nos prefatos iudicem et notarium ut in suos cum scirent expresse nos suos iudicem et notarium in hac parte non esse nec se fore nostre iuris dicioni subiectos ipsam nostram iurisdicionem et officium in se voluntarie prorogando</rdf:value>
    <dct:identifier>BCSL_35-PROROGATIO_IURISDICTIONIS-1636-1885</dct:identifier>
  </rdf:Description>

    <rdf:value xml:lang="la">per guadiam et stipulacionem legitimam et solemnem</rdf:value>
    <dct:identifier>BCSL_25-STIPULATIO-4937-4987</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_25-STIPULATIO-4937-4987">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#SpecificResource" />
    <oa:hasSource rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#document-BCSL_25" />
    <oa:hasSelector rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#selector-BCSL_25-STIPULATIO-4937-4987" />
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#selector-BCSL_25-STIPULATIO-4937-4987">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#TextPositionSelector" />

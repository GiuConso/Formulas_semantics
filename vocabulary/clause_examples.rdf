  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_30-RESTRICTIO_ALIENATIONIS-2272-2631">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#restrictio-alienationis" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_30-RESTRICTIO_ALIENATIONIS-2272-2631" />
    <rdf:value xml:lang="la">Item quod dictus conductor pro se et fratre et suis heredibus possint et valeant ipsas vineam et vineale vendere alienare permutare in dotem tradere seu quovis alio modo distrahere salvo dicto censu et pacto reservatis personis miserabilibus potencioribus et impotencioribus per quas solucio impediri po sset minui quomodolibet vel differri duntaxat exceptis.</rdf:value>
    <dct:identifier>BCSL_30-RESTRICTIO_ALIENATIONIS-2272-2631</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_30-RESTRICTIO_ALIENATIONIS-2272-2631">

    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_20-STIPULATIO-6999-7028" />
    <rdf:value xml:lang="la">solempni stipulacione vestito</rdf:value>
    <dct:identifier>BCSL_20-STIPULATIO-6999-7028</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_20-STIPULATIO-6999-7028">

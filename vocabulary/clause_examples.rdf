    <rdf:value xml:lang="la">ipsas infrascriptas moniales congregatas ad sonum campane ante crates ferreas prout iuris et moris est atque capitulum facientes pro infrascriptis agendis</rdf:value>
    <dct:identifier>BCSL_31-CAPITULUM-1032-1186</dct:identifier>
  </rdf:Description>

  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_35-DEFENSIO-4554-4689">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#defensio" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_35-DEFENSIO-4554-4689" />
    <rdf:value xml:lang="la">Quinymmo ipse moniales dicta vinealia libere defendere et antistare ab omnibus hominibus et personis sponte et libere salvo dicto censu</rdf:value>
    <dct:identifier>BCSL_35-DEFENSIO-4554-4689</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_35-DEFENSIO-4554-4689">

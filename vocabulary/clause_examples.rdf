    <rdf:value xml:lang="la">ad sonum campanelle congregatas pro maiori et saniori parte ipsarum et capitulum facientes et tenentes pro infrascriptis earum peragendis pro utilitate dicti earum monasterii ut dixerunt.</rdf:value>
    <dct:identifier>BCSL_25-CAPITULUM-1491-1678</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_25-CAPITULUM-1491-1678">

  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_27-PRECARIUM-3322-3679">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#precarium" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_27-PRECARIUM-3322-3679" />
    <rdf:value xml:lang="la">et interym, donec et quousque prefatus emptor et sui heredes adhepti fuerint corporalem possessionem dictarum vinearum, prefati venditores constituerunt se vineas ipsas cum iuribus suis predictis precario nomine et pro parte dicti emptoris tenere et possidere quod precarium prefatus emptor et sui heredes possint cum voluerint auctoritate propria revocare.</rdf:value>
    <dct:identifier>BCSL_27-PRECARIUM-3322-3679</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_27-PRECARIUM-3322-3679">

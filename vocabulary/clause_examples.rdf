    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_29-CAPITULUM-1034-1160" />
    <rdf:value xml:lang="la">infrascriptas venerabiles moniales et capitulum facientes ad sonum campane pro infrascriptis agendis pro ut moris iurisque est</rdf:value>
    <dct:identifier>BCSL_29-CAPITULUM-1034-1160</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_29-CAPITULUM-1034-1160">

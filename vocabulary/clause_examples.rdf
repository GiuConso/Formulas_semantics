  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_26-PRECARIUM-3692-4298">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#precarium" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_26-PRECARIUM-3692-4298" />
    <rdf:value xml:lang="la">et interym et donec dictus dompnus Mictulus corpo ralem possexionem dicti vinealis adeptus fuerit sicut supra, prefatus venditor coram nobis constituit se dictum vineale et ordines supradictos tenere et possidere precario nomine et pro parte dicti dompni Mictuli ac heredum et successorum suorum predictorum; quod precarium dictus venditor sicut supra constituit se dictum venditum beneficium precario nomine et pro parte ipsius emptoris et eius heredum et successorum tenere et eciam possidere; quod precarium dictus emptor et sui heredes et successores possint, cum voluerint, ad eorum dominium revocare.</rdf:value>
    <dct:identifier>BCSL_26-PRECARIUM-3692-4298</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_26-PRECARIUM-3692-4298">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#SpecificResource" />
    <oa:hasSource rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#document-BCSL_26" />
    <oa:hasSelector rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#selector-BCSL_26-PRECARIUM-3692-4298" />
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#selector-BCSL_26-PRECARIUM-3692-4298">

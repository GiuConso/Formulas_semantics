  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_22-CAPITULUM-1681-1829">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#capitulum" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_22-CAPITULUM-1681-1829" />
    <rdf:value xml:lang="la">ad sonum campanelle congregatas pro maiori et seniori parte ipsarum et capitulum facientes et tenentes pro infrascriptis earum agendis, ut dixerunt.</rdf:value>
    <dct:identifier>BCSL_22-CAPITULUM-1681-1829</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_22-CAPITULUM-1681-1829">

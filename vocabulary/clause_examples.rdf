    <oa:end rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">4372</oa:end>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_29-DEFENSIO-4709-4825">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#defensio" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_29-DEFENSIO-4709-4825" />
    <rdf:value xml:lang="la">qui immo vinealia ipsam iuribus defendere et antistare ab omnibus hominibus expresse salvo censu et pactis predictis</rdf:value>
    <dct:identifier>BCSL_29-DEFENSIO-4709-4825</dct:identifier>
  </rdf:Description>

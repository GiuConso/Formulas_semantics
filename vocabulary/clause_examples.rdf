    <oa:start rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3704</oa:start>
    <oa:end rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3960</oa:end>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_29-RESTRICTIO_ALIENATIONIS-3961-4372">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#restrictio-alienationis" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_29-RESTRICTIO_ALIENATIONIS-3961-4372" />
    <rdf:value xml:lang="la">Item quod dictus conductor suique heredes possint et valeant dicta vinealia cum omnibus beneficiis factis vel fiendis in eis vendere alienare permutare in dotem tradere seu quovis alio modo distrahere salvo semper annuo censu et pactis predictis ecclesiis vero ecclesiasticisque personis potentioribus et impotentioribus per quas dicti census solutio impediri possit quomodo libet vel differi dumtaxat exceptis.</rdf:value>
    <dct:identifier>BCSL_29-RESTRICTIO_ALIENATIONIS-3961-4372</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_29-RESTRICTIO_ALIENATIONIS-3961-4372">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#SpecificResource" />
    <oa:hasSource rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#document-BCSL_29" />
    <oa:hasSelector rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#selector-BCSL_29-RESTRICTIO_ALIENATIONIS-3961-4372" />
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#selector-BCSL_29-RESTRICTIO_ALIENATIONIS-3961-4372">

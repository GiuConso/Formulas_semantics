  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_30-RENUNTIATIO-4625-4956">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#renuntiatio" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_30-RENUNTIATIO-4625-4956" />
    <rdf:value xml:lang="la">Super quibus omnibus prefate moniales renunciaverunt speciali exceptioni doli mali vis metus et in factum actioni exceptioni privilegio fori seu nundinarum Baroli Trani Andrie et aliorum locorum quorumcunque omnique legum et utriusque iuris auxilio canonici et civilis singulisque aliis iuribus legibus usibus remediis et statutis.</rdf:value>
    <dct:identifier>BCSL_30-RENUNTIATIO-4625-4956</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_30-RENUNTIATIO-4625-4956">

  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#selector-BCSL_29-DEFENSIO-4709-4825">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#TextPositionSelector" />
    <oa:start rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">4709</oa:start>

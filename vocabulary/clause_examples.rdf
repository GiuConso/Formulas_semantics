  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_36-RENUNTIATIO-8745-10205">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#renuntiatio" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_36-RENUNTIATIO-8745-10205" />
    <rdf:value xml:lang="la">super quibus omnibus eorum singulis voluntarie prefatus conductor per se et suis heredibus dictis concedentibus presentibus et stipulantibus ut supra ex certa eius scientia et non per errorem renunciavit specialiter exceptioni doli mali vis metus et in factum accioni exceptioni predicte rei aliter geste quam scripte et presentis non sit celebrati contractus legi de bonis mobilibus vel stabilibus insolutum dandis et retinendis capitulo regio prohibenti boves aratorios et instrumenta ad agriculturam pertinencia obligari capi et detineri non posse privilegio fori seu nundinarum Baroli Trani et aliorum locorum quorumcunque omnique legum et utriusque iuris auxilio canonici et civilis iuri scripto et non scripto eddito vel eddendo usui consuetudinario constitucionario vel longobardo iuri legi et consuetudini que penam in contractibus prohibent adhiberi et adhibitam non valere consue tudini qua cavetur quod pena apposita in contractibus nullum sortiatur effectum. Singulisque aliis legibus iuribus usibus remediis privelegiis litteris regiis statutis mandatis consuetudinibus constitucionibus auxiliis moratoriis supersessoriis indultis et salvis conductibus impetratis vel impetrandis quibus seu ipsorum altero uti seu iuvare se possent et a presenti obligatione tueri et huius scripti tenor possit in toto vel in parte minui vel infringi et specialiter iuri dicenti generalem renunciationem non valere legi etiam prohibenti talem renunciacionem fieri.</rdf:value>
    <dct:identifier>BCSL_36-RENUNTIATIO-8745-10205</dct:identifier>
  </rdf:Description>

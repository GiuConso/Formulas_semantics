  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_29-PROROGATIO_IURISDICTIONIS-1421-1730">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#prorogatio-iurisdictionis" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_29-PROROGATIO_IURISDICTIONIS-1421-1730" />
    <rdf:value xml:lang="la">que quidem moniales et prior ipse consentientes prius in nos prefatos iudicem et notarium ut in suos cum scirent expresse et ex certa eorum scientia nos eorum iudicem et notarium in hac parte non esse nec fore nostre iurisdicioni subiectos iurisdicionem nostram et officium nostrum in se voluntarie prorogando</rdf:value>
    <dct:identifier>BCSL_29-PROROGATIO_IURISDICTIONIS-1421-1730</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_29-PROROGATIO_IURISDICTIONIS-1421-1730">

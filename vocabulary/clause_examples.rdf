  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_18-DEFENSIO-3915-4216">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#defensio" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_18-DEFENSIO-3915-4216" />
    <rdf:value xml:lang="la">quatenus ipsa venditrix et sui heredes dictam domum, loco et finibus superius designatam, cum iuribus suis omnibus sorori Petrelle et suis successoribus francam liberam et exemptam ab onere servitutis et solucionis alicuius quicquamque defendant et defendere teneantur et debeant ab omnibus hominibus.</rdf:value>
    <dct:identifier>BCSL_18-DEFENSIO-3915-4216</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_18-DEFENSIO-3915-4216">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#SpecificResource" />
    <oa:hasSource rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#document-BCSL_18" />

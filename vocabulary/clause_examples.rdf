  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_30-SANCTIO_NEGATIVA-4130-4624">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#sanctio-negativa" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_30-SANCTIO_NEGATIVA-4130-4624" />
    <rdf:value xml:lang="la">ad penam et sub pena unciarum auri quatuor si prefate moniales vel earum successores contrafecerint cuius pene medietas applicetur dictis conductoribus vel eorum successoribus et alia ipsius pene medietas appli cetur curie domini vicarii vel illi curie coram qua reclamatio seu querela exinde forte fiet dictis monia libus qua pena soluta vel non soluta aut graciose remissa presens nichilominus instrumentum cum eadem adiectione pene et omnibus in eo contentis semper in suo robore perseveret.</rdf:value>
    <dct:identifier>BCSL_30-SANCTIO_NEGATIVA-4130-4624</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_30-SANCTIO_NEGATIVA-4130-4624">

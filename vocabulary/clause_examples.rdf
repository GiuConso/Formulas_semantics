  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_21-PRECARIUM-5845-6677">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#precarium" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_21-PRECARIUM-5845-6677" />
    <rdf:value xml:lang="la">et interym tamen et donec dictus procurator vel constituentes eius poxessionem corporalem ipsius domus ac iurium accionum et pertinenciarum ipsius apprehenderint et adhepti fuerint venditrix ante lata fuit confexa pro se heredibus et successoribus suis domum ipsam iura et acciones ipsius precario nomine et pro parte ipsarum abbatisse et monialium ac monasterii et ecclesie supradicte tenere ac eciam possidere constituens ipsa venditrix dictum notarium Matheum nomine quo supra procuratorem voluntarie in rem suam. Ita tamen quod dictum precarium possit per dictas abbatissam et moniales ac dictum procuratorem nomine ipsarum ac successores earum quandocumque eis placuerit et videbitur absque requisicione aliqua dicte venditrici vel eius heredibus et successoribus fienda et alterius cuiuscumque iudicis decreto penitus revocari</rdf:value>
    <dct:identifier>BCSL_21-PRECARIUM-5845-6677</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_21-PRECARIUM-5845-6677">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#SpecificResource" />
    <oa:hasSource rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#document-BCSL_21" />
    <oa:hasSelector rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#selector-BCSL_21-PRECARIUM-5845-6677" />
  </rdf:Description>

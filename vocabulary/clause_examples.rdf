  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_36-CAPITULUM-1436-1642">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />

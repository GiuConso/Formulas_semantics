    <rdf:value xml:lang="la">quam ymmo vinealia ipsa cum iuribus omnibus supradictis libere defendere et antistare dicto conductori ab omnibus hominibus salvis tamen annuo censu et pactis predictis.</rdf:value>
    <dct:identifier>BCSL_25-DEFENSIO-4718-4887</dct:identifier>
  </rdf:Description>

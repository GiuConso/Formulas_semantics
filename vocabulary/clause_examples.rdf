    <rdf:value xml:lang="la">per guadiam et stipulacionem legitimam et sollempnem</rdf:value>
    <dct:identifier>BCSL_19-STIPULATIO-6059-6111</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_19-STIPULATIO-6059-6111">

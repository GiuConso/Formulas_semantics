    <oa:start rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3692</oa:start>
    <oa:end rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">4298</oa:end>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_26-DEFENSIO-4667-5000">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#defensio" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_26-DEFENSIO-4667-5000" />
    <rdf:value xml:lang="la">dictumque beneficium vinealis ut supra venditum voluntarie dopno Mictulo in quantum sua iusta vendicio ad illud [suis sunt] ab omnibus hominibus et personis defendere et [scientia] antestare denunciandi necessitate evictionis tempore per presentem venditorem ut supra dicto emptori et suis heredibus et successoribus ex pacto remissa</rdf:value>
    <dct:identifier>BCSL_26-DEFENSIO-4667-5000</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_26-DEFENSIO-4667-5000">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#SpecificResource" />
    <oa:hasSource rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#document-BCSL_26" />
    <oa:hasSelector rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#selector-BCSL_26-DEFENSIO-4667-5000" />
  </rdf:Description>

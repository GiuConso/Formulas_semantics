  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_33-PRECARIUM-3363-3671">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#precarium" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_33-PRECARIUM-3363-3671" />
    <rdf:value xml:lang="la">interim vero eidem dicto emptori suique heredes dicti beneficii ipsarum vinearum possessionem adepti fuerint corporaliter prefatus venditor constituit se vineas ipsas precario nomine et pro parte ipsius emptoris tenere et possidere [lacuna] quidem precarium possit cum voluerint auctoritate propria revocare.</rdf:value>
    <dct:identifier>BCSL_33-PRECARIUM-3363-3671</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_33-PRECARIUM-3363-3671">

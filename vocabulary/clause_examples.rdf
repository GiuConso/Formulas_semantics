  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_21-FIDEJUSSIO-11231-12178">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#fideiussio" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_21-FIDEJUSSIO-11231-12178" />
    <rdf:value xml:lang="la">posito defensore per eamdem venditricem penes dictum procuratorem, presentem et recipientem procuratorio nomine quo supra, in omnibus et singulis infrascriptis ad maius robur ipsarum abbatisse et monialium ac monasterii et ecclesie et successorum ipsarum in eo, prefato Miano, viro ipsius venditricis, presente ibidem et onus defensionis ipsius in se sponte suscipiente ac obligante se et suos heredes et successores per guadiam et stipulacionem legitimam et solempnem eidem procuratori, presenti recipienti et stipulanti ab eo, procuratorio nomine quo supra, obliga cionem eamdem, ad defensionem et evicionem dicte domus iurium actionum et pertinenciarum predictarum ut supra ac omnia alia et singula predicta, que et qualiter sunt prelecta, pro dicta venditrice modo superius obligata ac renunciante voluntarie coram nobis ex certa sui scientia dicto procuratori, presenti recipienti et stipulanti ut supra, iuri de primo principali conveniendo.</rdf:value>
    <dct:identifier>BCSL_21-FIDEJUSSIO-11231-12178</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_21-FIDEJUSSIO-11231-12178">

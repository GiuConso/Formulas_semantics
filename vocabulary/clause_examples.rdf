    <oa:hasSelector rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#selector-BCSL_30-OBLIGATIO-2951-4129" />
  </rdf:Description>

    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_36-IURAMENTUM-10206-10566" />
    <rdf:value xml:lang="la">Maioris quoque securitatis causa voluntarie prefatus conductor dictis concedentibus presentibus et stipulantibus ut supra iuravit ad Sancta Dei Evangelia per eum corporaliter manu tacta prolecta omnia et singula que et qualiter perleguntur adimplere attendere et inviolabiliter observare et contra non facere vel venire de iure vel de facto seu modo quocumque.</rdf:value>
    <dct:identifier>BCSL_36-IURAMENTUM-10206-10566</dct:identifier>
  </rdf:Description>

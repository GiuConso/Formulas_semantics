  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_30-RESTITUTIO_IN_INTEGRUM-2122-2271">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#restitutio-in-integrum" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_30-RESTITUTIO_IN_INTEGRUM-2122-2271" />
    <rdf:value xml:lang="la">et si cessaverint tam in solucione dicti census quam in cultura per annos duos statim cadant a concessione et quod possint capere auctoritate propria</rdf:value>
    <dct:identifier>BCSL_30-RESTITUTIO_IN_INTEGRUM-2122-2271</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_30-RESTITUTIO_IN_INTEGRUM-2122-2271">

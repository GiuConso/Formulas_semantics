    <rdf:value xml:lang="la">moniales conventuales monasterii antedicti in ibi ad sonum canpanelli pro maiori et saniori parte ipsarum more et loco solitis in simul congregatas et ad infrascriptam causam specialiter capitulum facientes</rdf:value>
    <dct:identifier>BCSL_36-CAPITULUM-1436-1642</dct:identifier>
  </rdf:Description>

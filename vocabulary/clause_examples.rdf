  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_22-IURAMENTUM-12367-12789">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#iuramentum" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_22-IURAMENTUM-12367-12789" />
    <rdf:value xml:lang="la">Maioris quoque securitatis causa prefatus dompnus Iacobus nomine quo supra et dictus Nicolaus censuarius voluntarie dictis monialibus presentibus et recipientibus ab eis nominibus iuraverunt ad sancta Dei evangelia per eos et unumquemque ipsorum corporaliter manibus tacta predicta omnia et singula dictis monialibus adimplere attendere et observare et contra non facere vel venire de iure vel de facto seu modo quocumque.</rdf:value>
    <dct:identifier>BCSL_22-IURAMENTUM-12367-12789</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_22-IURAMENTUM-12367-12789">

  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_25-PROROGATIO_IURISDICTIONIS-1679-1816">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#prorogatio-iurisdictionis" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_25-PROROGATIO_IURISDICTIONIS-1679-1816" />
    <rdf:value xml:lang="la">Que quidem moniales, consentientes prius in nos prefatos iudicem et notarium ut in suos nostreque iurisdictioni se voluntarie submittendo</rdf:value>
    <dct:identifier>BCSL_25-PROROGATIO_IURISDICTIONIS-1679-1816</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_25-PROROGATIO_IURISDICTIONIS-1679-1816">

  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_31-PROROGATIO_IURISDICTIONIS-1753-1957">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#prorogatio-iurisdictionis" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_31-PROROGATIO_IURISDICTIONIS-1753-1957" />
    <rdf:value xml:lang="la">consencientes prius in nos prefatos iudicem et notarium ut in suos cum scirent se ipsas non esse nec se fore nostre iurisdictioni subiectas iurisdictionem nostram et officium nostrum voluntarie prorogando</rdf:value>
    <dct:identifier>BCSL_31-PROROGATIO_IURISDICTIONIS-1753-1957</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_31-PROROGATIO_IURISDICTIONIS-1753-1957">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#SpecificResource" />
    <oa:hasSource rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#document-BCSL_31" />
    <oa:hasSelector rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#selector-BCSL_31-PROROGATIO_IURISDICTIONIS-1753-1957" />

  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_30-PROROGATIO_IURISDICTIONIS-853-1111">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#prorogatio-iurisdictionis" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_30-PROROGATIO_IURISDICTIONIS-853-1111" />
    <rdf:value xml:lang="la">qui quidem frater Antonius consenciens prius in nos prefatos iudicem et notarium ut in suos cum sciret expresse et ex certa sui scientia se non esse nec fore nostre iurisdicioni subiec tum iurisdicionem nostram et officium nostrum in se voluntarie prorogando</rdf:value>
    <dct:identifier>BCSL_30-PROROGATIO_IURISDICTIONIS-853-1111</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_30-PROROGATIO_IURISDICTIONIS-853-1111">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#SpecificResource" />
    <oa:hasSource rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#document-BCSL_30" />
    <oa:hasSelector rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#selector-BCSL_30-PROROGATIO_IURISDICTIONIS-853-1111" />
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#selector-BCSL_30-PROROGATIO_IURISDICTIONIS-853-1111">

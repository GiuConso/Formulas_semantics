    <oa:end rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">7374</oa:end>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_35-IURAMENTUM-7375-7680">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#iuramentum" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_35-IURAMENTUM-7375-7680" />
    <rdf:value xml:lang="la">Maioris quoque secruritatis causa voluntarie prefatis partis vinealis ut supra. Iuraverat supra Sancta Dei Evangelia per eos corporaliter manu tacta predicta omnia et singula attendere adimplere et observare et contra non facere dicere opponere allegare vel venire de iure vel de facto seu modo quocumque.</rdf:value>
    <dct:identifier>BCSL_35-IURAMENTUM-7375-7680</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_35-IURAMENTUM-7375-7680">

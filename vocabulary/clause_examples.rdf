  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_18-FIDEJUSSIO-4217-4745">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#fideiussio" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_18-FIDEJUSSIO-4217-4745" />
    <rdf:value xml:lang="la">Et proinde ipsa Zocia venditrix penes eundem fratrem Nicolaum, ibidem presentem et stipulantem ac recipientem nominibus quibus supra, defensorem dedit et posuit prefatum notarium Nicolaum virum suum, ibidem presentem volentem et sponte ad predictam et pro predictis defensionem ipsam suscipien­tem ac sese et bona sua omnia defensorio et fideiussorio nomine voluntarie obligantem dicto fratri Nicolao, presenti et stipulanti nominibus quibus supra, guadia et sollemni stipulacione inde adhibitis et intervenientibus ad predicta.</rdf:value>
    <dct:identifier>BCSL_18-FIDEJUSSIO-4217-4745</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_18-FIDEJUSSIO-4217-4745">

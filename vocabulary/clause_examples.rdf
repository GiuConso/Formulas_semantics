  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_20-PACTUM_REVOCATIONIS-6218-7054">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#pactum-revocationis" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_20-PACTUM_REVOCATIONIS-6218-7054" />
    <rdf:value xml:lang="la">pacto eciam habito inter ipsos venditores ex una parte et prefatam sororem Mitulam ex altera quod, ubi et quandocumque ipsa vel dictum monasterium noluerit presentem vendicionem et empcionem acceptare et eisdem Petruccio et Nicolao dictum censum restituere, teneantur dicti venditores, sicutque promiserunt dicte sorori Mitule stipulanti ut supra, restituere sibi et dicto monasterio dictas uncias sex, pretium dicte vendicionis, et dictum annuum censum ad eos dictamque proprietatem et possessionem revocare sine excepcione forte receptorum de dicto censu per eam vel eius monasterium supradictum, quod in censu predicto donaverunt ex iure dicto monasterio titulo donacionis irrevocabilis inter vivos et elemo sinaliter pro anima defunctorum suorum, quia sic convenerunt ex pacto solempni stipulacione vestito predicto die coram nobis.</rdf:value>
    <dct:identifier>BCSL_20-PACTUM_REVOCATIONIS-6218-7054</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_20-PACTUM_REVOCATIONIS-6218-7054">

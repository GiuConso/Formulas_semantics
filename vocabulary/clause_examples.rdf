    <rdf:value xml:lang="la">per guadiam et stipulacionem legitimam et sollemnpnem</rdf:value>
    <dct:identifier>BCSL_18-STIPULATIO-5810-5863</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_18-STIPULATIO-5810-5863">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#SpecificResource" />
    <oa:hasSource rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#document-BCSL_18" />

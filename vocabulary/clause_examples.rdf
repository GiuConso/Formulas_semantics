  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_36-PROROGATIO_IURISDICTIONIS-2000-2236">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#prorogatio-iurisdictionis" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_36-PROROGATIO_IURISDICTIONIS-2000-2236" />
    <rdf:value xml:lang="la">consensientes prius in nos prefatos iudicem et notarium ut in suos cum scirent expresse et ex certa earum scientia nostre non esse iurisdictioni subiectas iurisdicionem nostram et officium in se voluntarie prorogando et eidem subiciendo</rdf:value>
    <dct:identifier>BCSL_36-PROROGATIO_IURISDICTIONIS-2000-2236</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_36-PROROGATIO_IURISDICTIONIS-2000-2236">

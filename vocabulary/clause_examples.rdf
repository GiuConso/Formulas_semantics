  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_35-RESTRICTIO_ALIENATIONIS-3819-4144">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#restrictio-alienationis" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_35-RESTRICTIO_ALIENATIONIS-3819-4144" />
    <rdf:value xml:lang="la">Item quod dictus conductor possit et valeat dicta vinealia vendere donare permutare legare et quovis alio modo distrahere in dotemque dare salvis pactis et censu predictis ecclesiis vero ecclesiasticisque personis potentioribus et inpotencioribus per quas solucio dicti census possit quomodolibet impediri dum taxat exceptis.</rdf:value>
    <dct:identifier>BCSL_35-RESTRICTIO_ALIENATIONIS-3819-4144</dct:identifier>
  </rdf:Description>

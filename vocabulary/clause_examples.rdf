    <rdf:value xml:lang="la">per guadiam et stipulationem legitimam et solemnem</rdf:value>
    <dct:identifier>BCSL_27-STIPULATIO-3794-3844</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_27-STIPULATIO-3794-3844">

  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_23-DEFENSIO-4121-4516">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#defensio" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_23-DEFENSIO-4121-4516" />
    <rdf:value xml:lang="la">et quos census venditos super dictis vineis ipse Masellus per se et suos heredes inperpetuum defendere promisit et antistare libere dicte Petrelle presenti recipienti et stipulanti ab eo pro se et suis heredibus et successoribus ab omnibus hominibus denunciandi necessitate evictionis tempore per ipsum Masellum et suos heredes dicte Petrelle et suis heredibus et successoribus ex pacto remissa.</rdf:value>
    <dct:identifier>BCSL_23-DEFENSIO-4121-4516</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_23-DEFENSIO-4121-4516">

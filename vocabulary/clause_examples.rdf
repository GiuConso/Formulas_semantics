  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_29-RESTITUTIO_IN_INTEGRUM-3704-3960">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#restitutio-in-integrum" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_29-RESTITUTIO_IN_INTEGRUM-3704-3960" />
    <rdf:value xml:lang="la">et si cessaverint in solucione dicti census quod cadant a concessione predicta vinealia ipsa deveniant ad ipsum monasterium pleno iure sine questione aliqua et quod possint capere auctoritate eorum propria et ad eorum pristinum statum deducere et advocare.</rdf:value>
    <dct:identifier>BCSL_29-RESTITUTIO_IN_INTEGRUM-3704-3960</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_29-RESTITUTIO_IN_INTEGRUM-3704-3960">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#SpecificResource" />
    <oa:hasSource rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#document-BCSL_29" />
    <oa:hasSelector rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#selector-BCSL_29-RESTITUTIO_IN_INTEGRUM-3704-3960" />
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#selector-BCSL_29-RESTITUTIO_IN_INTEGRUM-3704-3960">

  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_33-PROROGATIO_IURISDICTIONIS-922-1161">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#prorogatio-iurisdictionis" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_33-PROROGATIO_IURISDICTIONIS-922-1161" />
    <rdf:value xml:lang="la">conscienciens prius in nos prefatos iudicem et notarium et testes ut in suos, cum sciret expresse et ex certa eius scientia nos suos iudicem notarium et testes non fore nec esse nostram iurisdicionem et officium in se voluntarie prorogando</rdf:value>
    <dct:identifier>BCSL_33-PROROGATIO_IURISDICTIONIS-922-1161</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_33-PROROGATIO_IURISDICTIONIS-922-1161">

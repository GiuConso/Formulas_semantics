  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_27-DEFENSIO-4128-4371">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#defensio" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_27-DEFENSIO-4128-4371" />
    <rdf:value xml:lang="la">quin ymmo vineas ipsas cum iuribus omnibus supradictis dicto Blasio emptori et suis heredibus libere defendere et antistare ab omnibus hominibus, denunciandi necessitate evictionis tempore per ipsos venditores prefato emptori ex pacto remissa.</rdf:value>
    <dct:identifier>BCSL_27-DEFENSIO-4128-4371</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_27-DEFENSIO-4128-4371">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#SpecificResource" />
    <oa:hasSource rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#document-BCSL_27" />

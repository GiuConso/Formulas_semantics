  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_21-STIPULATIO-7492-7543">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />

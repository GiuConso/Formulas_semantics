    <oa:end rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">7859</oa:end>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_29-IURAMENTUM-7860-8158">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#iuramentum" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_29-IURAMENTUM-7860-8158" />
    <rdf:value xml:lang="la">Maioris quoque securitatis causa voluntarie prefatus Nardus iuravit supra Sancta Dei Evangelia per eum corporaliter manu tacta predicta omnia et singula adimplere attendere et inviolabiliter observare et contra non facere dicere opponere allegare vel venire de iure vel de facto seu modo quocumque.</rdf:value>
    <dct:identifier>BCSL_29-IURAMENTUM-7860-8158</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_29-IURAMENTUM-7860-8158">

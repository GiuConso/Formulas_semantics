  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#BCSL_27-IURAMENTUM-7091-7427">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Annotation" />
    <oa:hasBody rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_repertoire.ttl#iuramentum" />
    <oa:hasTarget rdf:resource="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_27-IURAMENTUM-7091-7427" />
    <rdf:value xml:lang="la">Maioris quoque securitatis causa prefati venditores voluntarie dicto emptori presenti et recipienti iuraverunt ad Sancta Dei Evangelia per eos corporaliter tacta [premissa] predicta omnia et singula que et qualiter preleguntur eidem emptori adimplere et observare et contra non facere vel dicere de iure vel de facto seu modo quocumque.</rdf:value>
    <dct:identifier>BCSL_27-IURAMENTUM-7091-7427</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://raw.githubusercontent.com/GiuConso/Formulas_semantics/main/vocabulary/clause_examples.ttl#target-BCSL_27-IURAMENTUM-7091-7427">
